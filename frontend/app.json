{
  "expo": {
    "name": "VitaGuide",
    "slug": "vitaguide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vitaguide",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.emergent.personalizemeals3127497d",
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "VitaGuide verwendet Bluetooth, um dein VitaGuide Band zu verbinden und Gesundheitswerte zu synchronisieren.",
        "NSBluetoothPeripheralUsageDescription": "VitaGuide verwendet Bluetooth, um dein VitaGuide Band zu verbinden und Gesundheitswerte zu synchronisieren.",
        "UIBackgroundModes": ["bluetooth-central"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A8B71"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.stressreliefapp.xznvct",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ]
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#2E7D52"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F9F6"
        }
      ],
      "expo-asset",
      "expo-web-browser",
      "expo-font",
      "expo-dev-client"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
