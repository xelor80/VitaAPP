{
  "expo": {
    "name": "VitaGuide",
    "slug": "vitaguide",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "vitaguide",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "buildNumber": "2",
      "bundleIdentifier": "app.emergent.personalizemeals3127497d",
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      },
      "infoPlist": {
        "NSBluetoothAlwaysUsageDescription": "VitaGuide verwendet Bluetooth, um dein VitaGuide Band zu verbinden und Gesundheitswerte zu synchronisieren.",
        "NSBluetoothPeripheralUsageDescription": "VitaGuide verwendet Bluetooth, um dein VitaGuide Band zu verbinden und Gesundheitswerte zu synchronisieren.",
        "NSHealthShareUsageDescription": "VitaGuide liest Herzfrequenz, HRV, SpO2, Schlaf, Schritte und Kalorien aus Apple Health, um dir personalisierte Readiness- und Recovery-Insights zu geben.",
        "NSHealthUpdateUsageDescription": "VitaGuide schreibt optional Workouts, Achtsamkeits-Sessions und Trink-Erinnerungen zurück in Apple Health.",
        "UIBackgroundModes": [
          "bluetooth-central"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4A8B71"
      },
      "edgeToEdgeEnabled": true,
      "versionCode": 2,
      "package": "com.emergent.stressreliefapp.xznvct",
      "permissions": [
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_ADMIN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.health.READ_HEART_RATE",
        "android.permission.health.READ_RESTING_HEART_RATE",
        "android.permission.health.READ_HEART_RATE_VARIABILITY",
        "android.permission.health.READ_OXYGEN_SATURATION",
        "android.permission.health.READ_RESPIRATORY_RATE",
        "android.permission.health.READ_BODY_TEMPERATURE",
        "android.permission.health.READ_SKIN_TEMPERATURE",
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_DISTANCE",
        "android.permission.health.READ_ACTIVE_CALORIES_BURNED",
        "android.permission.health.READ_TOTAL_CALORIES_BURNED",
        "android.permission.health.READ_SLEEP",
        "android.permission.health.READ_EXERCISE",
        "android.permission.health.READ_BLOOD_PRESSURE",
        "android.permission.health.READ_BLOOD_GLUCOSE"
      ]
    },
    "notification": {
      "icon": "./assets/icon.png",
      "color": "#2E7D52"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F9F6"
        }
      ],
      "expo-asset",
      "expo-web-browser",
      "expo-font",
      "expo-dev-client",
      "./plugins/with-hband-sdk",
      [
        "react-native-health",
        {
          "isClinicalDataEnabled": false,
          "healthSharePermission": "VitaGuide liest Herzfrequenz, HRV, SpO2, Schlaf, Schritte und Kalorien aus Apple Health, um dir personalisierte Readiness- und Recovery-Insights zu geben.",
          "healthUpdatePermission": "VitaGuide schreibt optional Workouts, Achtsamkeits-Sessions und Trink-Erinnerungen zurück in Apple Health."
        }
      ],
      "react-native-health-connect"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
