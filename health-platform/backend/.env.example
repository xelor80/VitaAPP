# --- VitaGuide Backend – Beispiel-Umgebung ---
# Kopieren nach .env und Werte setzen. NIEMALS echte Secrets committen.

NODE_ENV=development
PORT=3000

# PostgreSQL (siehe docker-compose.yml)
DATABASE_URL="postgresql://vitaguide:vitaguide@localhost:5432/vitaguide?schema=public"

# JWT / Auth  (openssl rand -base64 48)
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_TTL="900s"      # 15 Minuten
JWT_REFRESH_TTL="30d"      # 30 Tage

# Feldverschlüsselung (AES-256-GCM) – 32-Byte-Key base64 (openssl rand -base64 32)
ENCRYPTION_KEY="change-me-32-byte-base64-key===="

# CORS – erlaubte Origins (kommagetrennt)
CORS_ORIGINS="http://localhost:3001,https://admin.vitaguide.app"
