# === VitaGuide – Produktions-Umgebung (nach .env.production kopieren) ===
# NIEMALS committen. Secrets erzeugen: openssl rand -base64 48

# Projektname => isoliert Container/Volumes von anderen Projekten
COMPOSE_PROJECT_NAME=vitaguide

# --- Domains (bei Hostinger als DNS-A-Records auf die VPS-IP zeigen lassen) ---
API_DOMAIN=api.vitaguide.app
ADMIN_DOMAIN=admin.vitaguide.app

# --- Vorhandenes Traefik (deines VPS) ---
# Name des externen Docker-Netzwerks, an dem dein Traefik hängt:
#   docker network ls   (z. B. "web", "traefik", "proxy")
TRAEFIK_NETWORK=web
# Name deines cert-resolvers in der Traefik-Config (Let's Encrypt):
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Datenbank (nur intern erreichbar) ---
POSTGRES_USER=vitaguide
POSTGRES_PASSWORD=CHANGE-ME-strong
POSTGRES_DB=vitaguide

# --- Secrets ---
JWT_ACCESS_SECRET=CHANGE-ME
JWT_REFRESH_SECRET=CHANGE-ME
JWT_ADMIN_SECRET=CHANGE-ME
ENCRYPTION_KEY=CHANGE-ME-32-byte-base64

# --- Start-Admin (Portal-Login). Passwort nach erstem Login ändern! ---
ADMIN_EMAIL=admin@vitaguide.app
ADMIN_PASSWORD=CHANGE-ME-admin-pw
# Beim allerersten Hochfahren auf true setzen, damit Admin + App-Config angelegt werden.
# Danach wieder auf false (idempotent, aber unnötig):
SEED_ON_START=true

# --- Push (optional, später) ---
PUSH_PROVIDER=noop
FCM_PROJECT_ID=
